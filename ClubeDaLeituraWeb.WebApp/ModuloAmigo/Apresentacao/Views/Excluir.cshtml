@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Amigos";
}

@model ExcluirAmigoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      method="post">

    <input type="hidden" asp-for="Id" /> 

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label asp-for="NomeResponsavel" class="form-label fw-semibold text-primary text-uppercase small">Nome do Responsável</label>
        <input asp-for="NomeResponsavel" type="text" class="form-control" disabled>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label fw-semibold text-primary text-uppercase small">Telefone</label>
        <input asp-for="Telefone" type="text" class="form-control" disabled>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Confirmar Exclusão</button>
    </div>
</form>