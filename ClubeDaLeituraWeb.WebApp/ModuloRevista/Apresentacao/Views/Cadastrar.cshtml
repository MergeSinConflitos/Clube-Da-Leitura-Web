@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Revista";

    List<SelectListItem> caixas = ViewBag.Caixas;
}

@model CadastrarRevistasViewModel;

<div class="container py-4">
    <h1 class="display-6 fw-semibold text-primary mb-4">@ViewBag.Titulo</h1>

    <form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar"
          method="post">

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Título</label>
            <input asp-for="Titulo" type="text" class="form-control">
            <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NumeroDeEdicao" class="form-label fw-semibold text-primary text-uppercase small">Número de
                Edição</label>
                <input asp-for="NumeroDeEdicao" type="number" min="1" class="form-control">
                <span asp-validation-for="NumeroDeEdicao" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AnoDePublicacao" class="form-label fw-semibold text-primary text-uppercase small">Ano de
                    Publicação</label>
                    <input asp-for="AnoDePublicacao" type="number" class="form-control">
                    <span asp-validation-for="AnoDePublicacao" class="text-danger small fw-semibold"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CaixaId" class="form-label fw-semibold text-primary text-uppercase small">Caixa</label>
                    <select asp-for="CaixaId" asp-items="caixas" class="form-select">
                        <option value="CaixaId">Selecione uma caixa</option>
                    </select>
                    <span asp-validation-for="CaixaId" class="text-danger small fw-semibold"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
                    <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
                </div>
            </form>
        </div>