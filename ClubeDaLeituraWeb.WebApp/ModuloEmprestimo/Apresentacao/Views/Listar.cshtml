@using ClubeDaLeituraWeb.WebApp.ModuloEmprestimo.Dominio

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Empréstimos";
}

@model List<ListarEmprestimosViewModel>;

@if (TempData["ERRO"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ERRO"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum empréstimo cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Amigo</th>
                    <th>Revista</th>
                    <th>Abertura</th>
                    <th>Devolução Prevista</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarEmprestimosViewModel e in Model)
                {
                    //atrasados
                    
                    <tr class="@(e.EstaAtrasado ? "table-danger" : "")">
                        <td>@e.Id</td>
                        <td>@e.NomeAmigo</td>
                        <td>@e.TituloRevista</td>
                        <td>@e.Abertura.ToShortDateString()</td>
                        <td>@e.ConclusaoPrevista.ToShortDateString()</td>
                        <td>
                            @if (e.EstaAtrasado)
                            {
                                <span class="badge bg-danger">Atrasado</span>
                            }
                            else if (e.Status == StatusEmprestimo.Aberto)
                            {
                                <span class="badge bg-primary">Aberto</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Concluído</span>
                            }
                        </td>
                        <td>
                            @if (e.Status == StatusEmprestimo.Aberto || e.EstaAtrasado)
                            {
                                <a class="btn btn-outline-success btn-sm rounded-pill px-3"
                                   asp-action="Concluir"
                                   asp-route-id="@e.Id">Concluir</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}